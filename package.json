{
  "name": "limittrack",
  "version": "1.2.0",
  "description": "Track reset times for rate-limited coding tool accounts (Antigravity, Codex, Claude Code, and more) across multiple emails, with live countdowns and native desktop notifications.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:styles": "npx --yes --package tailwindcss@3.4.17 tailwindcss -c tailwind.config.js -i styles.input.css -o app.css --minify",
    "test": "node --test"
  },
  "author": {
    "name": "Abdul Rehman",
    "email": "rehmanoncloud9@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/rehmanoncloud9/limittrack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rehmanoncloud9/limittrack.git"
  },
  "bugs": {
    "url": "https://github.com/rehmanoncloud9/limittrack/issues"
  },
  "keywords": [
    "electron",
    "antigravity",
    "codex",
    "claude-code",
    "rate-limit",
    "desktop-app",
    "productivity"
  ],
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.limittrack",
    "productName": "LimitTrack",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "domain.js",
      "state-client.js",
      "store.js",
      "app.css",
      "typography.css",
      "assets/fonts/**/*",
      "index.html",
      "widget.html",
      "widget.js",
      "icon.png",
      "favicon.ico",
      "LICENSE",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
